{
  "name": "irc-colors",
  "description": "Color and formatting for irc made easy.",
  "keywords": [
    "irc",
    "color",
    "colour"
  ],
  "version": "1.5.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/irc-colors.js.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "main": "./dist/irc-colors.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit",
    "test:unit": "mocha --require ts-node/register test/*-test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "license": "MIT",
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
